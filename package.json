{
  "name": "reps",
  "version": "1.0.0",
  "description": "Short mental-skill games: mental math, estimation, calibration, vocabulary, attention.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/check.mjs",
    "serve": "npx --yes serve .",
    "gen": "node scripts/gen-sw.mjs",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "audit:exports": "node scripts/unused-exports.mjs",
    "e2e": "node --test \"e2e/**/*.e2e.test.js\"",
    "verify": "npm run lint && npm run check && npm test && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
